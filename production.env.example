# Copy these names into your deployment platform's secret/environment settings.
# Do NOT commit real secret values.
SPRING_PROFILES_ACTIVE=prod
QR_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Enable only for the one-time first master-admin creation.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_SECRET=
FRONTEND_BASE_URL=https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
SCHOOL_TIME_ZONE=Asia/Manila
RATE_LIMIT_ENABLED=true

# Optional: subscription lifecycle scan interval (default 1 hour)
PICKUPPASS_SUBSCRIPTION_LIFECYCLE_MS=3600000

# SMTP used only when a master admin explicitly emails an invoice.
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_READ_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000

# Phase 3 billing documents/email
BILLING_COMPANY_NAME=PickupPass
BILLING_COMPANY_ADDRESS=
BILLING_SUPPORT_EMAIL=
BILLING_FROM_EMAIL=
BILLING_FROM_NAME=PickupPass Billing

# Payment webhook adapter secret. Use a long random value and configure the same secret in your payment provider/bridge.
PAYMENT_WEBHOOK_GENERIC_SECRET=

# Startup manual GCash subscription collection
# Keep these values only on the backend. The mobile app reads them through the authenticated billing API.
BILLING_GCASH_ENABLED=true
BILLING_GCASH_ACCOUNT_NAME=YOUR_GCASH_ACCOUNT_NAME
BILLING_GCASH_MOBILE=09XXXXXXXXX
BILLING_GCASH_NOTE=Send the exact invoice amount. After paying, submit the GCash reference number in PickupPass for manual verification.

# Phase 3 billing reminders / receipts
BILLING_REMINDERS_ENABLED=true
# 6 hours; reminders themselves are deduplicated per invoice stage
BILLING_REMINDER_SCAN_MS=21600000

# Phase 3 SaaS operations health dashboard
# Default full platform scan: once per day. Important GCash, billing-email, subscription-lifecycle, and overdue-invoice changes refresh affected tenant health immediately.
SAAS_OPERATIONS_HEALTH_SCAN_MS=86400000
# Opening the dashboard will lazily refresh if the materialized health view is older than this many hours.
SAAS_OPERATIONS_STALE_HOURS=24
# Warn before a tenant actually reaches a student/staff/campus plan limit.
SAAS_OPERATIONS_QUOTA_WARNING_PERCENT=90

# Phase 3 security center: random 32+ character secret used only to HMAC request fingerprints.
SECURITY_FINGERPRINT_SECRET=replace-with-a-separate-random-32-plus-character-secret

# Phase 3 disaster recovery. Leave disabled until IAM is configured intentionally.
# Startup-first protection: platform owner chooses the profile.
# free = delete protection only; startup = delete protection + 7-day daily backup;
# growth = daily + weekly backups + PITR + delete protection.
FIRESTORE_DR_ENABLED=false
FIRESTORE_DR_ALLOW_RESTORE_DRILLS=false
FIRESTORE_DR_PROJECT_ID=your-google-cloud-project-id
FIRESTORE_DR_DATABASE_ID=(default)
# Prefer workload/application-default credentials in production. Set a path only when necessary.
FIRESTORE_DR_CREDENTIALS_PATH=
FIRESTORE_DR_DAILY_RETENTION_DAYS=7
FIRESTORE_DR_WEEKLY_RETENTION_DAYS=84
FIRESTORE_DR_WEEKLY_DAY=SUNDAY
FIRESTORE_DR_HEALTH_INITIAL_DELAY_MS=120000
FIRESTORE_DR_HEALTH_SCAN_MS=21600000
FIRESTORE_DR_MAX_BACKUP_AGE_HOURS=48
FIRESTORE_DR_DEFAULT_PROFILE=startup

# Tenant self-service data exports are direct downloads and are OFF per school
# until the platform owner enables them. These limits bound read/memory cost.
TENANT_DATA_EXPORT_MAX_DOCUMENTS=25000
TENANT_DATA_EXPORT_MAX_ARCHIVE_BYTES=52428800

# Firestore TTL is recommended only for explicitly ephemeral technical collections.
# Configure TTL on `expiresAt` for securityAuthWindows and idempotencyKeys in Google Cloud.
# PickupPass does not auto-delete exit logs, audit logs, or billing records.
# Phase 3 Update 14 - startup/low-cost observability
# In-memory HTTP metrics produce no per-request Firestore writes.
OBSERVABILITY_WINDOW_MINUTES=15
OBSERVABILITY_MINIMUM_REQUESTS=20
OBSERVABILITY_SERVER_ERROR_RATE_PERCENT=10
OBSERVABILITY_SLOW_REQUEST_RATE_PERCENT=25
OBSERVABILITY_SLOW_REQUEST_MS=2000
OBSERVABILITY_MEMORY_WARNING_PERCENT=85
OBSERVABILITY_FIRESTORE_FAILURE_THRESHOLD=2
OBSERVABILITY_INITIAL_DELAY_MS=60000
OBSERVABILITY_EVALUATE_MS=300000
OBSERVABILITY_DURABLE_INCIDENTS_ENABLED=true

