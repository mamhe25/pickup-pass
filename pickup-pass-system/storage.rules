rules_version = '2';
// NOT DEPLOYED BY DEFAULT — see firebase.json, which intentionally omits
// the "storage" target. As of Feb 3, 2026, Cloud Storage for Firebase
// requires the pay-as-you-go Blaze plan even for entirely free-tier usage,
// so this app stores avatars/logos as base64 data URIs directly in
// Firestore instead (see SchoolLogoService and ProfileRepository) and
// never provisions a Storage bucket at all.
//
// Kept here only in case you later upgrade to Blaze and want to switch
// back to real Storage uploads for larger files — these rules match the
// path convention the earlier client-side avatar upload code used
// (schools/{schoolId}/parents/{parentUid}/{fileName}), capped at 100KB.
service firebase.storage {
  match /b/{bucket}/o {
    match /schools/{schoolId}/parents/{parentUid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == parentUid
        && request.resource.size < 100 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }
  }
}
