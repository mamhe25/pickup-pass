# PickupPass local development environment
# Copy this file to `.env` in the same backend directory.
# Never put real credentials in this example file.

SPRING_PROFILES_ACTIVE=dev

# Stable local QR signing secret. Generate once:
# py -c "import secrets; print(secrets.token_urlsafe(48))"
QR_SIGNING_SECRET=replace-with-a-random-local-secret

# Frontend / CORS
FRONTEND_BASE_URL=http://localhost:5500
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
SCHOOL_TIME_ZONE=Asia/Manila
RATE_LIMIT_ENABLED=true

# Preferred Firebase local auth is Application Default Credentials:
#   gcloud auth application-default login
# Leave blank when ADC works.
# Fallback only: point to a credential file OUTSIDE this Git repository.
FIREBASE_PROJECT_ID=pickuppass
FIREBASE_CREDENTIALS_PATH=

# Gmail SMTP example
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_READ_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000

# Bootstrap must remain off after the first master admin exists.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_SECRET=

# Use a separate random local value; never reuse production secrets.
SECURITY_FINGERPRINT_SECRET=replace-with-a-separate-random-local-secret

# Normal local defaults
DISMISSAL_WINDOW_MINUTES=120
QR_TOKEN_TTL_MINUTES=15
MAX_GUARDIANS_PER_STUDENT=4

# Keep disaster-recovery mutation features disabled in ordinary local development.
FIRESTORE_DR_ENABLED=false
FIRESTORE_DR_ALLOW_RESTORE_DRILLS=false
