rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      return !userDoc().keys().hasAll(['isActive']) || userDoc().isActive == true;
    }

    function sameSchool(schoolId) {
      return isSignedIn() && request.auth.token.schoolId == schoolId && isUserActive();
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.role == 'master_admin';
    }

    function isSchoolStaff(schoolId) {
      return sameSchool(schoolId) &&
        (request.auth.token.role == 'school_admin' || request.auth.token.role == 'teacher');
    }

    match /schools/{schoolId} {
      allow read: if sameSchool(schoolId) || isMasterAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId ||
         isMasterAdmin() ||
         isSchoolStaff(resource.data.schoolId));

      allow create: if false;
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl']);
      allow delete: if false;
    }

    match /students/{studentId} {
      allow read: if isSchoolStaff(resource.data.schoolId) ||
        (isSignedIn() && resource.data.guardianUids.hasAny([request.auth.uid]));
      allow create, update, delete: if false;
    }

    match /pickupTokens/{tokenId} {
      allow read, write: if false;
    }

    match /exitLogs/{logId} {
      allow read: if isSchoolStaff(resource.data.schoolId) ||
        (isSignedIn() && resource.data.parentUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }
  }
}
